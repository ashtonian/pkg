go 1.27.0

// Every published module, so a change to one is tested against the others'
// working trees. The config cookbook, httpx Gin example and benchmarks,
// and release tooling have separate dependency graphs and checks.
use (
	./gowalker
	./parse
	./config
	./config/kongprovider
	./httpx
	./httpx/codec/msgpack
	./httpx/codec/proto
	./httpx/compress/brotli
)

// Resolve the optional modules' parent requirement before the first public
// httpx/v0.1.0 tag exists. Keep this version-specific and workspace-only:
// published go.mod files and archive-consumer checks use the real requirement.
replace github.com/ashtonian/pkg/httpx v0.1.0 => ./httpx
