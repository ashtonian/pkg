            "replace"
          ],
          "data_type": "decimal"
        },
        "/ratio": {
          "allowed_ops": [
            "replace"
          ],
          "data_type": "float",
          "number_kind": "float64"
        },
        "/scores": {
          "allowed_ops": [
            "replace",
            "add",
            "remove",
            "array_append"
          ],
          "data_type": "array",
          "nullable": true,
          "elem": "int",
          "number_kind": "int16"
        },
        "/seen_at": {
          "allowed_ops": [
            "replace",
            "remove"
          ],
          "data_type": "timestamp",
          "nullable": true
        },
        "/small": {
          "allowed_ops": [
            "replace"
          ],
          "data_type": "int",
          "number_kind": "int8"
        },
        "/status": {
          "allowed_ops": [
            "replace"
          ],
          "data_type": "string",
          "enum_values": [
            "active",
            "offline"
          ]
        },
        "/tags": {
          "allowed_ops": [
            "replace",
            "add",
            "remove",
            "array_append"
          ],
          "data_type": "array",
          "nullable": true,
          "elem": "string"
        }
      },
      "max_operations": 50
    }
