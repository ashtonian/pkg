        "/mode": {
          "allowed_ops": [
            "replace",
            "remove"
          ],
          "data_type": "string",
          "nullable": true,
          "enum_values": [
            "auto",
            "manual"
          ]
        },
        "/modes": {
          "allowed_ops": [
            "replace",
            "add",
            "remove",
            "array_append"
          ],
          "data_type": "array",
          "nullable": true,
          "enum_values": [
            "auto",
            "manual"
          ],
          "elem": "string"
        },
