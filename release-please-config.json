{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "packages": {
    "config": {
      "component": "config",
      "exclude-paths": [
        "config/kongprovider",
        "config/examples/cookbook"
      ]
    },
    "config/kongprovider": {
      "component": "config/kongprovider"
    },
    "httpx": {
      "component": "httpx",
      "initial-version": "0.1.0",
      "exclude-paths": [
        "httpx/codec/msgpack",
        "httpx/codec/proto",
        "httpx/compress/brotli",
        "httpx/examples/gin",
        "httpx/internal/bench"
      ]
    },
    "httpx/codec/msgpack": {
      "component": "httpx/codec/msgpack",
      "initial-version": "0.1.0"
    },
    "httpx/codec/proto": {
      "component": "httpx/codec/proto",
      "initial-version": "0.1.0"
    },
    "httpx/compress/brotli": {
      "component": "httpx/compress/brotli",
      "initial-version": "0.1.0"
    },
    "gowalker": {
      "component": "gowalker",
      "initial-version": "0.1.0"
    }
  }
}
