{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "last-release-sha": "b98d84c5ce000b457cdec5086dd7897368a96c42",
  "packages": {
    "parse": {
      "component": "parse",
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "json",
          "path": "sdk/ts/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "sdk/ts/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "sdk/ts/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ]
    },
    "config": {
      "component": "config",
      "exclude-paths": [
        "config/kongprovider",
        "config/examples/cookbook"
      ]
    },
    "config/kongprovider": {
      "component": "config/kongprovider"
    },
    "httpx": {
      "component": "httpx",
      "initial-version": "0.1.0",
      "exclude-paths": [
        "httpx/oauth2",
        "httpx/codec/msgpack",
        "httpx/codec/proto",
        "httpx/compress/brotli",
        "httpx/examples/gin",
        "httpx/internal/bench"
      ]
    },
    "httpx/oauth2": {
      "component": "httpx/oauth2",
      "initial-version": "0.1.0"
    },
    "httpx/codec/msgpack": {
      "component": "httpx/codec/msgpack",
      "initial-version": "0.1.0"
    },
    "httpx/codec/proto": {
      "component": "httpx/codec/proto",
      "initial-version": "0.1.0"
    },
    "httpx/compress/brotli": {
      "component": "httpx/compress/brotli",
      "initial-version": "0.1.0"
    },
    "gowalker": {
      "component": "gowalker",
      "initial-version": "0.1.0"
    },
    "jsonvalue": {
      "component": "jsonvalue",
      "initial-version": "0.1.0"
    },
    "gitx": {
      "component": "gitx",
      "initial-version": "0.1.0"
    },
    "process": {
      "component": "process",
      "initial-version": "0.1.0"
    },
    "state": {
      "component": "state",
      "initial-version": "0.1.0"
    },
    "onepassword": {
      "component": "onepassword",
      "initial-version": "0.1.0"
    }
  }
}
